# Backend Environment Variables

# Environment mode
# development | production
NODE_ENV=development

# MongoDB Connection String
# Local example: mongodb://localhost:27017/regle-de-trois
# Atlas example: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/regle-de-trois

# JWT Secret for authentication tokens
# Use a strong random value (minimum 32 chars in production)
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET

# Optional token expiry (jsonwebtoken format)
JWT_EXPIRES_IN=7d

# Port to run the server on
PORT=3001

# Allowed frontend origins for CORS
# FRONTEND_URL supports a single origin
# FRONTEND_URLS supports comma-separated origins
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=

# Set true when running behind a reverse proxy/load balancer
TRUST_PROXY=false
